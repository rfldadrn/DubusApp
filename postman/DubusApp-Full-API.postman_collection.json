{
  "info": {
    "name": "DubusApp Full API",
    "description": "Collection lengkap endpoint DubusApp: auth login flow, endpoint publik, endpoint protected (session), endpoint internal token, dan cron token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8d2f6db5-a757-47f7-9dd8-9cdbf346f4e9"
  },
  "item": [
    {
      "name": "01 - Auth (NextAuth)",
      "item": [
        {
          "name": "01.1 - Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf"
              ]
            },
            "description": "Ambil csrfToken dan cookie awal."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data && data.csrfToken) {",
                  "  pm.collectionVariables.set('csrfToken', data.csrfToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "01.2 - Login Credentials (Callback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfToken",
                  "value": "{{csrfToken}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "callbackUrl",
                  "value": "{{baseUrl}}/dashboard",
                  "type": "text"
                },
                {
                  "key": "json",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "redirect",
                  "value": "false",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/credentials",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "callback",
                "credentials"
              ]
            },
            "description": "Login pakai credentials provider. Cookie session akan dipakai otomatis oleh Postman untuk request berikutnya pada domain sama."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of expected values', function () {",
                  "  pm.expect([200, 302, 401]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.3 - Get Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            },
            "description": "Verifikasi login berhasil dan session aktif."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.4 - Providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "providers"
              ]
            }
          }
        },
        {
          "name": "01.5 - Sign In Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            }
          }
        },
        {
          "name": "01.6 - Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfToken",
                  "value": "{{csrfToken}}",
                  "type": "text"
                },
                {
                  "key": "callbackUrl",
                  "value": "{{baseUrl}}/login",
                  "type": "text"
                },
                {
                  "key": "json",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Public API",
      "item": [
        {
          "name": "02.1 - Track Order (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/track?code={{trackCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "track"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{trackCode}}"
                }
              ]
            },
            "description": "Endpoint publik untuk tracking kode transaksi."
          }
        },
        {
          "name": "02.2 - Track Order (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{trackCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/track",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "track"
              ]
            }
          }
        },
        {
          "name": "02.3 - Track Order (OPTIONS)",
          "request": {
            "method": "OPTIONS",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/track",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "track"
              ]
            },
            "description": "CORS preflight check."
          }
        }
      ]
    },
    {
      "name": "03 - Protected API (Session)",
      "item": [
        {
          "name": "03.1 - List Sizes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sizes/list?customerId={{customerId}}&itemId={{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sizes",
                "list"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                },
                {
                  "key": "itemId",
                  "value": "{{itemId}}"
                }
              ]
            },
            "description": "Wajib login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of expected values', function () {",
                  "  pm.expect([200, 400, 401]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03.2 - Get Item Size Fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/sizes?itemId={{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "sizes"
              ],
              "query": [
                {
                  "key": "itemId",
                  "value": "{{itemId}}"
                }
              ]
            },
            "description": "Wajib login."
          }
        },
        {
          "name": "03.3 - Create Size",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"itemId\": {{itemId}},\n  \"note\": \"Ukuran postman\",\n  \"sizeValues\": [\n    {\n      \"itemSizeId\": {{itemSizeId1}},\n      \"size\": 90\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sizes/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sizes",
                "create"
              ]
            },
            "description": "Wajib login. Pastikan itemSizeId valid untuk item yang dipilih."
          }
        },
        {
          "name": "03.4 - Update Size",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headerSizeCustomerId\": {{headerSizeCustomerId}},\n  \"note\": \"Update dari postman\",\n  \"sizeValues\": [\n    {\n      \"itemSizeId\": {{itemSizeId1}},\n      \"size\": 91\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sizes/update",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sizes",
                "update"
              ]
            },
            "description": "Wajib login."
          }
        }
      ]
    },
    {
      "name": "04 - Internal API (Token)",
      "item": [
        {
          "name": "04.1 - RBAC Allowed Paths",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-rbac-internal-token",
                "value": "{{rbacInternalToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/internal/rbac/allowed-paths?roleId={{roleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internal",
                "rbac",
                "allowed-paths"
              ],
              "query": [
                {
                  "key": "roleId",
                  "value": "{{roleId}}"
                }
              ]
            },
            "description": "Wajib token internal."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of expected values', function () {",
                  "  pm.expect([200, 400, 401]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Cron API (Token)",
      "item": [
        {
          "name": "05.1 - Cron Backup Unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cron/db-backup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cron",
                "db-backup"
              ]
            }
          }
        },
        {
          "name": "05.2 - Cron Backup Authorized",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{cronSecret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cron/db-backup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cron",
                "db-backup"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of expected values', function () {",
                  "  pm.expect([200, 401, 500, 502]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
