generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model StatusItem {
  id               Int               @id @default(autoincrement())
  code             String            @unique @db.VarChar(10)
  name             String            @db.VarChar(100)
  description      String?           @db.VarChar(255)
  colorSlug        String?           @db.VarChar(100)
  iconSlug         String?           @db.VarChar(100)
  sequence         Int               @default(0)
  rowStatus        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactionItems TransactionItem[]

  @@map("status_items")
}

model StatusTransaction {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(10)
  name         String        @db.VarChar(100)
  description  String?       @db.VarChar(255)
  colorSlug    String?       @db.VarChar(100)
  iconSlug     String?       @db.VarChar(100)
  sequence     Int           @default(0)
  rowStatus    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@map("status_transactions")
}

model Sequence {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(50)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("sequences")
}

model Role {
  id               Int               @id @default(autoincrement())
  roleName         String            @db.VarChar(100)
  rowStatus        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  roleMenuMappings RoleMenuMapping[]
  users            User[]

  @@map("roles")
}

model Menu {
  id               Int               @id @default(autoincrement())
  menuName         String            @db.VarChar(100)
  menuUrl          String?           @db.VarChar(255)
  menuIcon         String?           @db.VarChar(50)
  menuSlug         String?           @db.VarChar(100)
  parentId         Int               @default(0)
  isMenu           Boolean           @default(false)
  orderNo          Int               @default(0)
  rowStatus        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  roleMenuMappings RoleMenuMapping[]

  @@map("menus")
}

model RoleMenuMapping {
  id        Int      @id @default(autoincrement())
  roleId    Int
  menuId    Int
  createdAt DateTime @default(now())
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId, menuId], map: "idx_role_menu_mappings_role_menu")
  @@map("role_menu_mappings")
}

model User {
  id                    Int                  @id @default(autoincrement())
  fullName              String               @db.VarChar(255)
  username              String               @unique @db.VarChar(100)
  password              String               @db.VarChar(255)
  roleId                Int
  rowStatus             Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  agenciesCreated       Agency[]
  auditLogs             AuditLog[]
  cashLedgersCreated    CashLedger[]         @relation("CashLedgerCreatedBy")
  deliveriesHandled     Delivery[]
  sizeHeadersCreated    HeaderSizeCustomer[]
  ironingLogsHandled    IroningLog[]
  paymentsReceived      Payment[]
  payrollsProcessed     Payroll[]            @relation("PayrollPaidBy")
  productionLogsUpdated ProductionLog[]
  transactionsCreated   Transaction[]
  role                  Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("users")
}

model EmployeeType {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(255)
  rowStatus   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@map("employee_types")
}

model Employee {
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(100)
  address        String?           @db.VarChar(255)
  phoneNumber    String?           @db.VarChar(20)
  email          String?           @db.VarChar(100)
  gender         Gender?
  joinDate       DateTime?
  employeeTypeId Int?
  avatar         String?           @db.VarChar(255)
  rowStatus      Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  employeeType   EmployeeType?     @relation(fields: [employeeTypeId], references: [id])
  payrolls       Payroll[]
  assignedItems  TransactionItem[]
  workerLogs     WorkerLog[]

  @@map("employees")
}

model PaymentType {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(15)
  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(255)
  defaultWalletId Int?
  rowStatus       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  defaultWallet   Wallet?   @relation(fields: [defaultWalletId], references: [id])
  payments        Payment[]

  @@map("payment_types")
}

model Item {
  id                                                       Int                  @id @default(autoincrement())
  code                                                     String               @unique @db.VarChar(10)
  name                                                     String               @db.VarChar(150)
  description                                              String?
  category                                                 String?              @db.VarChar(100)
  genderTarget                                             GenderTarget         @default(Unisex)
  customerPrice                                            Decimal              @db.Decimal(10, 2)
  employeePrice                                            Decimal              @db.Decimal(10, 2)
  rowStatus                                                Boolean              @default(true)
  createdAt                                                DateTime             @default(now())
  updatedAt                                                DateTime             @updatedAt
  defaultDesignId                                          Int?
  clothing_designs_clothing_designs_itemIdToitems          clothing_designs[]   @relation("clothing_designs_itemIdToitems")
  headerSizeCustomers                                      HeaderSizeCustomer[]
  itemSizes                                                ItemSize[]
  clothing_designs_items_defaultDesignIdToclothing_designs clothing_designs?    @relation("items_defaultDesignIdToclothing_designs", fields: [defaultDesignId], references: [id])
  transactionItems                                         TransactionItem[]

  @@map("items")
}

model ItemSize {
  id                Int                @id @default(autoincrement())
  itemId            Int
  name              String             @db.VarChar(100)
  isMandatory       Boolean            @default(false)
  isStandard        Boolean            @default(true)
  sortOrder         Int                @default(0)
  rowStatus         Boolean            @default(true)
  itemSizeCustomers ItemSizeCustomer[]
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_sizes")
}

model Fabric {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  fabricType       String            @db.VarChar(100)
  pricePerMeter    Decimal           @db.Decimal(10, 2)
  stockMeters      Decimal           @default(0) @db.Decimal(10, 2)
  rowStatus        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactionItems TransactionItem[]

  @@map("fabrics")
}

model Wallet {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(100)
  walletType     WalletType
  bankName       String?       @db.VarChar(100)
  accountNumber  String?       @db.VarChar(50)
  openingBalance Decimal       @default(0) @db.Decimal(18, 2)
  openingDate    DateTime
  isActive       Boolean       @default(true)
  notes          String?       @db.VarChar(255)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cashLedgers    CashLedger[]
  paymentTypes   PaymentType[]
  payments       Payment[]

  @@map("wallets")
}

model Customer {
  id           Int                  @id @default(autoincrement())
  name         String               @db.VarChar(100)
  phoneNumber  String?              @db.VarChar(20)
  gender       Gender?
  agencyId     Int?
  rowStatus    Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  agency       Agency?              @relation(fields: [agencyId], references: [id])
  sizeHeaders  HeaderSizeCustomer[]
  transactions Transaction[]

  @@index([rowStatus, createdAt(sort: Desc)])
  @@map("customers")
}

model HeaderSizeCustomer {
  id                Int                @id @default(autoincrement())
  customerId        Int
  itemId            Int
  note              String?
  createdBy         Int
  rowStatus         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdByUser     User               @relation(fields: [createdBy], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  itemSizeCustomers ItemSizeCustomer[]
  transactionItems  TransactionItem[]

  @@map("header_size_customers")
}

model ItemSizeCustomer {
  id                   Int                @id @default(autoincrement())
  itemSizeId           Int
  headerSizeCustomerId Int
  size                 Decimal            @db.Decimal(10, 2)
  rowStatus            Boolean            @default(true)
  headerSizeCustomer   HeaderSizeCustomer @relation(fields: [headerSizeCustomerId], references: [id], onDelete: Cascade)
  itemSize             ItemSize           @relation(fields: [itemSizeId], references: [id], onDelete: Cascade)

  @@map("item_size_customers")
}

model Agency {
  id            Int             @id @default(autoincrement())
  agencyCode    String          @unique @db.VarChar(10)
  name          String          @db.VarChar(100)
  description   String?         @db.VarChar(255)
  rowStatus     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  createdBy     Int
  createdByUser User            @relation(fields: [createdBy], references: [id])
  projects      AgencyProject[]
  customers     Customer[]

  @@map("agencies")
}

model AgencyProject {
  id             Int           @id @default(autoincrement())
  projectCode    String        @unique @db.VarChar(25)
  agencyId       Int
  name           String        @db.VarChar(100)
  description    String?       @db.VarChar(255)
  picName        String?       @db.VarChar(100)
  picPhone       String?       @db.VarChar(20)
  startDate      DateTime?
  targetDate     DateTime?
  contractStatus AgencyStatus  @default(Active)
  rowStatus      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  agency         Agency        @relation(fields: [agencyId], references: [id])
  deliveries     Delivery[]
  transactions   Transaction[]

  @@index([rowStatus, agencyId])
  @@map("agency_projects")
}

model Transaction {
  id                  Int               @id @default(autoincrement())
  transactionCode     String            @unique @db.VarChar(50)
  customerId          Int
  agencyProjectId     Int?
  type                TransactionType   @default(Regular)
  transactionDate     DateTime
  completionDate      DateTime?
  totalAmount         Decimal           @db.Decimal(18, 2)
  paymentStatus       PaymentStatus     @default(Unpaid)
  statusTransactionId Int
  note                String?           @db.VarChar(500)
  createdBy           Int
  rowStatus           Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  payments            Payment[]
  items               TransactionItem[]
  agencyProject       AgencyProject?    @relation(fields: [agencyProjectId], references: [id], onDelete: Restrict)
  createdByUser       User              @relation(fields: [createdBy], references: [id])
  customer            Customer          @relation(fields: [customerId], references: [id])
  statusTransaction   StatusTransaction @relation(fields: [statusTransactionId], references: [id])

  @@index([customerId], map: "idx_transactions_customerid")
  @@index([rowStatus, createdAt], map: "idx_transactions_rowstatus_createdat")
  @@index([rowStatus, paymentStatus], map: "idx_transactions_rowstatus_paymentstatus")
  @@index([statusTransactionId], map: "idx_transactions_statustransactionid")
  @@index([agencyProjectId, rowStatus, createdAt(sort: Desc)])
  @@map("transactions")
}

model TransactionItem {
  id                   Int                     @id @default(autoincrement())
  transactionId        Int
  itemId               Int
  headerSizeCustomerId Int?
  fabricSource         FabricSource            @default(Store)
  fabricId             Int?
  fabricName           String?                 @db.VarChar(150)
  fabricPrice          Decimal?                @db.Decimal(10, 2)
  fabricMeters         Decimal?                @db.Decimal(10, 2)
  modelDescription     String?
  modelImageUrl        String?                 @db.VarChar(500)
  sewingPrice          Decimal                 @db.Decimal(10, 2)
  targetDate           DateTime?
  statusItemId         Int
  assignedTailorId     Int?
  rowStatus            Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  designId             Int?
  useDefaultDesign     Boolean                 @default(true)
  deliveryItems        DeliveryItem[]
  ironingLog           IroningLog?
  productionLogs       ProductionLog[]
  charges              TransactionItemCharge[]
  assignedTailor       Employee?               @relation(fields: [assignedTailorId], references: [id])
  clothing_designs     clothing_designs?       @relation(fields: [designId], references: [id])
  fabric               Fabric?                 @relation(fields: [fabricId], references: [id])
  headerSizeCustomer   HeaderSizeCustomer?     @relation(fields: [headerSizeCustomerId], references: [id])
  item                 Item                    @relation(fields: [itemId], references: [id])
  statusItem           StatusItem              @relation(fields: [statusItemId], references: [id])
  transaction          Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  workerLogs           WorkerLog[]

  @@index([rowStatus, statusItemId], map: "idx_transaction_items_rowstatus_statusitemid")
  @@index([targetDate], map: "idx_transaction_items_targetdate")
  @@index([rowStatus, targetDate], map: "idx_transaction_items_rowstatus_targetdate")
  @@index([transactionId], map: "idx_transaction_items_transactionid")
  @@index([transactionId, rowStatus])
  @@map("transaction_items")
}

model TransactionItemCharge {
  id                Int             @id @default(autoincrement())
  transactionItemId Int
  label             String          @db.VarChar(150)
  amount            Decimal         @db.Decimal(10, 2)
  note              String?         @db.VarChar(255)
  rowStatus         Boolean         @default(true)
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)

  @@map("transaction_item_charges")
}

model Payment {
  id              Int         @id @default(autoincrement())
  transactionId   Int
  amount          Decimal     @db.Decimal(18, 2)
  balanceAfter    Decimal     @db.Decimal(18, 2)
  paymentTypeId   Int
  walletId        Int
  note            String?     @db.VarChar(500)
  receivedBy      Int
  paidAt          DateTime    @default(now())
  cashLedgerEntry CashLedger?
  paymentType     PaymentType @relation(fields: [paymentTypeId], references: [id])
  receivedByUser  User        @relation(fields: [receivedBy], references: [id])
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet          Wallet      @relation(fields: [walletId], references: [id])

  @@index([paidAt(sort: Desc)])
  @@index([transactionId])
  @@index([walletId, paidAt(sort: Desc)])
  @@map("payments")
}

model ProductionLog {
  id                Int             @id @default(autoincrement())
  transactionItemId Int
  fromStatusId      Int
  toStatusId        Int
  notes             String?         @db.VarChar(255)
  updatedBy         Int
  createdAt         DateTime        @default(now())
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)
  updatedByUser     User            @relation(fields: [updatedBy], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([transactionItemId])
  @@map("production_logs")
}

model IroningLog {
  id                Int             @id @default(autoincrement())
  transactionItemId Int             @unique
  ironingType       IroningType
  sentAt            DateTime        @default(now())
  returnedAt        DateTime?
  handledBy         Int
  notes             String?         @db.VarChar(255)
  handledByUser     User            @relation(fields: [handledBy], references: [id])
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)

  @@map("ironing_logs")
}

model Delivery {
  id              Int            @id @default(autoincrement())
  deliveryCode    String         @unique @db.VarChar(50)
  agencyProjectId Int
  deliveryDate    DateTime
  destination     String         @db.VarChar(255)
  recipientName   String?        @db.VarChar(100)
  recipientPhone  String?        @db.VarChar(20)
  status          DeliveryStatus @default(Pending)
  notes           String?
  handledBy       Int
  createdAt       DateTime       @default(now())
  agencyProject   AgencyProject  @relation(fields: [agencyProjectId], references: [id])
  handledByUser   User           @relation(fields: [handledBy], references: [id])
  items           DeliveryItem[]

  @@index([agencyProjectId, deliveryDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("deliveries")
}

model DeliveryItem {
  id                Int             @id @default(autoincrement())
  deliveryId        Int
  transactionItemId Int
  foldType          FoldType        @default(Folded)
  recipientNote     String?         @db.VarChar(150)
  delivery          Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id])

  @@map("delivery_items")
}

model WorkerLog {
  id                Int             @id @default(autoincrement())
  transactionItemId Int
  employeeId        Int
  role              WorkerRole
  upah              Decimal         @db.Decimal(10, 2)
  isPaid            Boolean         @default(false)
  payrollId         Int?
  createdAt         DateTime        @default(now())
  employee          Employee        @relation(fields: [employeeId], references: [id])
  payroll           Payroll?        @relation(fields: [payrollId], references: [id])
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)

  @@index([employeeId, isPaid, createdAt(sort: Desc)])
  @@map("worker_logs")
}

model Payroll {
  id              Int         @id @default(autoincrement())
  employeeId      Int
  periodStart     DateTime
  periodEnd       DateTime
  totalItems      Int
  totalAmount     Decimal     @db.Decimal(12, 2)
  paidAt          DateTime    @default(now())
  paidBy          Int
  notes           String?     @db.VarChar(255)
  cashLedgerEntry CashLedger?
  employee        Employee    @relation(fields: [employeeId], references: [id])
  paidByUser      User        @relation("PayrollPaidBy", fields: [paidBy], references: [id])
  workerLogs      WorkerLog[]

  @@map("payrolls")
}

model CashLedger {
  id            Int           @id @default(autoincrement())
  entryDate     DateTime      @default(now())
  type          CashEntryType
  category      String        @db.VarChar(100)
  description   String        @db.VarChar(500)
  amount        Decimal       @db.Decimal(18, 2)
  walletId      Int
  paymentId     Int?          @unique
  payrollId     Int?          @unique
  createdBy     Int
  createdByUser User          @relation("CashLedgerCreatedBy", fields: [createdBy], references: [id])
  payment       Payment?      @relation(fields: [paymentId], references: [id])
  payroll       Payroll?      @relation(fields: [payrollId], references: [id])
  wallet        Wallet        @relation(fields: [walletId], references: [id])

  @@index([entryDate], map: "idx_cash_ledger_entrydate")
  @@index([type, entryDate], map: "idx_cash_ledger_type_entrydate")
  @@index([walletId, entryDate], map: "idx_cash_ledger_walletid_entrydate")
  @@map("cash_ledger")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   @db.VarChar(50)
  tableName String   @db.VarChar(100)
  recordId  Int
  oldValues Json?
  newValues Json?
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([tableName, recordId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model clothing_designs {
  id                                            Int               @id @default(autoincrement())
  code                                          String            @unique @db.VarChar(50)
  name                                          String            @db.VarChar(150)
  description                                   String?           @db.VarChar(255)
  category                                      String?           @db.VarChar(100)
  genderTarget                                  GenderTarget      @default(Unisex)
  svgContent                                    String
  isBuiltin                                     Boolean           @default(false)
  itemId                                        Int?
  rowStatus                                     Boolean           @default(true)
  createdAt                                     DateTime          @default(now())
  updatedAt                                     DateTime
  items_clothing_designs_itemIdToitems          Item?             @relation("clothing_designs_itemIdToitems", fields: [itemId], references: [id])
  items_items_defaultDesignIdToclothing_designs Item[]            @relation("items_defaultDesignIdToclothing_designs")
  transaction_items                             TransactionItem[]

  @@index([rowStatus, itemId])
}

enum Gender {
  Laki_laki @map("Laki-laki")
  Perempuan
}

enum GenderTarget {
  Pria
  Wanita
  Unisex
}

enum FabricSource {
  Customer
  Store
}

enum TransactionType {
  Regular
  Agency
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid
}

enum WalletType {
  Cash
  QRIS
  BankAccount
  Other
}

enum IroningType {
  Internal
  External
}

enum FoldType {
  Folded
  Hanged
}

enum DeliveryStatus {
  Pending
  PartialDelivered
  FullyDelivered
}

enum AgencyStatus {
  Negotiation
  Active
  Completed
  Cancelled
}

enum WorkerRole {
  Tailor
  Cutter
}

enum CashEntryType {
  Debit
  Credit
}
